VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Change this when backend runs on a non-default port.
VITE_BACKEND_PROXY_TARGET=http://localhost:8080

# Optional for path-based production deployment, for example Oracle nginx path.
VITE_PUBLIC_BASE_PATH=/
VITE_API_BASE_URL=

# Backend runs on http://localhost:8080 during local development.
# YouTube/Claude keys belong in backend/.env or shell env, not Vite env.
